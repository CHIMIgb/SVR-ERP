model users_roles {
  id                                    String   @id @db.Uuid
  user_id                               String   @db.Uuid
  rol_id                                String   @db.Uuid
  es_principal                          Boolean  @default(false)
  asignado_en                           DateTime @db.Timestamptz() @default(now())
  asignado_por                          String?  @db.Uuid
  activo                                Boolean  @default(true)
  users_users_roles_asignado_porTousers users?   @relation("users_roles_asignado_porTousers", fields: [asignado_por], references: [id], onUpdate: NoAction, map: "fk_users_roles_asignado_por")
  roles                                 roles    @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  users_users_roles_user_idTousers      users    @relation("users_roles_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, rol_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuarios_bloqueados {
  id                                                            String           @id @db.Uuid
  user_id                                                       String?          @db.Uuid
  ip_address                                                    String?
  nivel_id                                                      String?          @db.Uuid
  nivel_numero                                                  Int
  intentos_fallidos_consecutivos                                Int
  bloqueado_desde                                               DateTime @db.Timestamptz()
  bloqueado_hasta                                               DateTime @db.Timestamptz()
  desbloqueado_en                                               DateTime? @db.Timestamptz()
  desbloqueado_manualmente_por                                  String?          @db.Uuid
  motivo                                                        String?
  activo                                                        Boolean          @default(true)
  creado_en                                                     DateTime @db.Timestamptz()         @default(now())
  actualizado_en                                                DateTime @db.Timestamptz()
  users_usuarios_bloqueados_desbloqueado_manualmente_porTousers users?           @relation("usuarios_bloqueados_desbloqueado_manualmente_porTousers", fields: [desbloqueado_manualmente_por], references: [id], onUpdate: NoAction, map: "fk_usuarios_bloqueados_desbloqueado_por")
  niveles_bloqueo                                               niveles_bloqueo? @relation(fields: [nivel_id], references: [id])
  users_usuarios_bloqueados_user_idTousers                      users?           @relation("usuarios_bloqueados_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, activo])
  @@index([ip_address, activo])
}

model vistas {
  id                                  String        @id @db.Uuid
  nombre                              String
  descripcion                         String?
  ruta                                String        @unique
  icono                               String?
  orden                               Int           @default(0)
  vista_padre_id                      String?       @db.Uuid
  es_menu                             Boolean       @default(true)
  es_visible                          Boolean       @default(true)
  requiere_auth                       Boolean       @default(true)
  target                              String        @default("_self")
  badges                              Json          @default("[]")
  metadata                            Json          @default("{}")
  activo                              Boolean       @default(true)
  creado_en                           DateTime @db.Timestamptz()      @default(now())
  actualizado_en                      DateTime @db.Timestamptz()
  creado_por                          String?       @db.Uuid
  actualizado_por                     String?       @db.Uuid
  eliminado_en                        DateTime? @db.Timestamptz()
  role_vistas                         role_vistas[]
  users_vistas_actualizado_porTousers users?        @relation("vistas_actualizado_porTousers", fields: [actualizado_por], references: [id], onUpdate: NoAction, map: "fk_vistas_actualizado_por")
  users_vistas_creado_porTousers      users?        @relation("vistas_creado_porTousers", fields: [creado_por], references: [id], onUpdate: NoAction, map: "fk_vistas_creado_por")
  vistas                              vistas?       @relation("vistasTovistas", fields: [vista_padre_id], references: [id])
  other_vistas                        vistas[]      @relation("vistasTovistas")

  @@index([activo, es_menu, es_visible], map: "idx_vistas_activas")
  @@index([vista_padre_id])
}

