/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model alertas_gps {
  id             String    @id @db.Uuid
  maquina_id     String    @db.Uuid
  tipo           String
  severidad      String
  lat            Decimal?  @db.Decimal(9, 6)
  lng            Decimal?  @db.Decimal(9, 6)
  fecha_hora     DateTime @db.Timestamptz()
  descripcion    String?
  atendida       Boolean   @default(false)
  atendida_por   String?   @db.Uuid
  atendida_en    DateTime? @db.Timestamptz()
  activo         Boolean   @default(true)
  creado_en      DateTime @db.Timestamptz()  @default(now())
  actualizado_en DateTime @db.Timestamptz()
  maquinas       maquinas  @relation(fields: [maquina_id], references: [id], onDelete: Cascade)
  users          users?    @relation(fields: [atendida_por], references: [id], onUpdate: NoAction, map: "fk_alertas_gps_atendida_por")

  @@index([atendida])
  @@index([maquina_id, fecha_hora(sort: Desc)])
}

