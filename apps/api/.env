# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/svr_erp"

# JWT Secrets
JWT_ACCESS_SECRET="svr-erp-access-secret-k3y-2026-prod"
JWT_REFRESH_SECRET="svr-erp-refresh-secret-k3y-2026-prod"

# Puerto de la API
PORT=3001

# URL del frontend (usada para CORS)
FRONTEND_URL=http://localhost:3000

# CORS opcional: lista separada por comas de origenes permitidos
# Si se define, anula FRONTEND_URL
# CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Configuracion de bloqueo por IP (rate limiting / anti brute-force)
BLOQUEO_IP_MAX_INTENTOS=10
BLOQUEO_IP_VENTANA_MINUTOS=15
BLOQUEO_IP_MINUTOS=60
