# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/svr_erp"

# Zona horaria oficial de la empresa (Nayarit Costa Sur => America/Mexico_City)
TZ=America/Mexico_City
TIMEZONE=America/Mexico_City

# JWT Secrets
JWT_ACCESS_SECRET="svr-erp-access-secret-k3y-2026-prod"
JWT_REFRESH_SECRET="svr-erp-refresh-secret-k3y-2026-prod"

# Puerto de la API
PORT=3001

# URL del frontend (usada para CORS si CORS_ORIGINS no está definida)
FRONTEND_URL=http://localhost:3000

# CORS opcional: lista separada por comas de origenes permitidos
# Si se define, anula FRONTEND_URL. Incluye localhost y la IP de tu laptop.
CORS_ORIGINS=http://localhost:3000,http://192.168.0.105:3000

# Configuracion de bloqueo por IP (rate limiting / anti brute-force)
BLOQUEO_IP_MAX_INTENTOS=10
BLOQUEO_IP_VENTANA_MINUTOS=15
BLOQUEO_IP_MINUTOS=60

# Expiracion de tokens JWT (formato: seconds, ex. 900=15m, 604800=7d)
ACCESS_TOKEN_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_SECONDS=604800
