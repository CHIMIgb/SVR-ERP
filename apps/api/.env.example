# Base de datos PostgreSQL
DATABASE_URL=

# JWT Secrets
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Puerto de la API
PORT=

# URL del frontend (usada para CORS si CORS_ORIGINS no está definida)
FRONTEND_URL=

# CORS opcional: lista separada por comas de origenes permitidos
# Si se define, anula FRONTEND_URL. Incluye localhost y la IP de tu laptop.
# CORS_ORIGINS=http://localhost:3000,http://192.168.0.105:3000

# Configuracion de bloqueo por IP (rate limiting / anti brute-force)
BLOQUEO_IP_MAX_INTENTOS=
BLOQUEO_IP_VENTANA_MINUTOS=
BLOQUEO_IP_MINUTOS=


# Expiracion de tokens JWT (formato: seconds, ex. 900=15m, 604800=7d)
ACCESS_TOKEN_EXPIRY_SECONDS=
REFRESH_TOKEN_EXPIRY_SECONDS=

# Zona horaria oficial de la empresa (Nayarit Costa Sur => America/Mexico_City)
TZ=America/Mexico_City
TIMEZONE=America/Mexico_City