# Puerto del dev server de Next.js
# Asegurate de que no sea el mismo que la API (3001)
PORT=

# URL de la API de NestJS
NEXT_PUBLIC_API_URL=

# URL pública de la app (PR #18 #10): la que recibe el trabajador en el
# mensaje de WhatsApp del alta/reinicio de PIN. Debe abrirse desde el
# teléfono — usa tu IP LAN o el dominio final, nunca localhost.
NEXT_PUBLIC_APP_URL=

# Orígenes permitidos para HMR/dev resources de Next.js
# Separados por comas. Ejemplo: localhost,192.168.0.105
ALLOWED_DEV_ORIGINS=
