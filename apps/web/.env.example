# ============================================================================
# RAILWAY — este archivo es del servicio WEB (Next.js, apps/web).
# Variables que se configuran en el servicio WEB de Railway:
#   NEXT_PUBLIC_API_URL    → URL ABSOLUTA de la API (https://<api>.railway.app/api).
#                            NO uses /api en producción: el rewrite de dev no
#                            existe ahí y el navegador ya habla HTTPS.
#   NEXT_PUBLIC_APP_URL    → dominio HTTPS de la WEB (link del WhatsApp).
#   NEXT_PUBLIC_TZ         → America/Mexico_City (única fuente de zona horaria).
#   PORT / ALLOWED_DEV_ORIGINS → solo dev; Railway asigna el puerto.
#   API_PROXY_DESTINATION  → NO configurar en Railway (el proxy es SOLO dev).
# Variables que se configuran en el servicio API de Railway (apps/api/.env.example):
#   DATABASE_URL, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET,
#   ACCESS_TOKEN_EXPIRY_SECONDS, REFRESH_TOKEN_EXPIRY_SECONDS,
#   TZ y TIMEZONE, BLOQUEO_IP_*, THROTTLE_*,
#   FRONTEND_URL o CORS_ORIGINS → deben apuntar al dominio HTTPS de la WEB.
# ============================================================================

# Puerto del dev server de Next.js
# Asegurate de que no sea el mismo que la API (3001)
PORT=

# URL de la API de NestJS
NEXT_PUBLIC_API_URL=

# Destino del PROXY DE LA API EN DEV (solo servicio WEB, NUNCA Railway).
# Solo se usa si NEXT_PUBLIC_API_URL=/api (ruta relativa): Next redirige
# /api/* a esta URL server-side para evitar mixed content con HTTPS local.
# No lleva prefijo NEXT_PUBLIC_: es una URL de localhost que no debe
# hornearse en el bundle. Ejemplo local:
# API_PROXY_DESTINATION=http://localhost:3001/api
API_PROXY_DESTINATION=

# URL pública de la app (PR #18 #10): la que recibe el trabajador en el
# mensaje de WhatsApp del alta/reinicio de PIN. Debe abrirse desde el
# teléfono — usa tu IP LAN o el dominio final, nunca localhost.
NEXT_PUBLIC_APP_URL=

# Orígenes permitidos para HMR/dev resources de Next.js
# Separados por comas. Ejemplo: localhost,192.168.0.105
ALLOWED_DEV_ORIGINS=

# Zona horaria oficial de la empresa (Nayarit Costa Sur)
# Única fuente en el código web: PROHIBIDO hardcodear America/Mexico_City
NEXT_PUBLIC_TZ=America/Mexico_City
